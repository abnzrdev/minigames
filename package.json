{
  "name": "minigames",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,scss,html}\"",
    "format:check": "prettier --check \"src/**/*.{ts,scss,html}\"",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "eslint": "^10.10.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.7",
    "sass": "^1.104.1",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
